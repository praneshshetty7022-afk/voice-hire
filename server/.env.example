# ====================================================================
# VoiceHire Backend - Environment Configuration
# ====================================================================

# Port (Render dynamically sets PORT in cloud; local default is 5000)
PORT=5000
NODE_ENV=development

# --------------------------------------------------------------------
# MongoDB Atlas Database URI
# --------------------------------------------------------------------
# Connect -> Drivers -> Node.js -> Copy connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/voicehire?retryWrites=true&w=majority

# --------------------------------------------------------------------
# JWT Security Settings
# --------------------------------------------------------------------
# Provide a strong, high-entropy secret string for signing JSON Web Tokens
JWT_SECRET=voicehire_super_secret_jwt_key_2026_udyoga_mitra_platform_secure_token
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# Allowed Frontend Origins (Vercel deployment or localhost)
# --------------------------------------------------------------------
CLIENT_URL=http://localhost:3000
