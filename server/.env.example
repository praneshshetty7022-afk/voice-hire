# ====================================================================
# VoiceHire Backend - Environment Configuration
# ====================================================================

# Port (Render sets this dynamically via PORT; local default is 5000)
PORT=5000
NODE_ENV=development

# --------------------------------------------------------------------
# MongoDB Atlas Database URI
# --------------------------------------------------------------------
# 1. Sign up at https://www.mongodb.com/cloud/atlas
# 2. Create a Free Cluster (M0)
# 3. Network Access: Add IP Address -> 0.0.0.0/0 (Allow from anywhere)
# 4. Database Access: Create user (e.g. voicehire_admin) & password
# 5. Connect -> Drivers -> Node.js -> Copy connection string:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/voicehire?retryWrites=true&w=majority

# --------------------------------------------------------------------
# JWT Security
# --------------------------------------------------------------------
JWT_SECRET=voicehire_production_secure_jwt_secret_token_2026_super_key
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# Allowed Frontend Origins (Vercel deployment or localhost)
# --------------------------------------------------------------------
CLIENT_URL=http://localhost:3000

