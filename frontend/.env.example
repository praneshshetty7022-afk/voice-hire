# ====================================================================
# VoiceHire Frontend - Environment Variables Template
# ====================================================================

# Backend API Base URL
# In hosting (Vercel, Netlify, Render, AWS), point to your live backend endpoint.
# Make sure to include the /api context path:
# Example: https://voicehire-backend.onrender.com/api
# Example: https://api.yourdomain.com/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# Language and Voice Settings
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_VOICE_SYNTHESIS=true
