# ====================================================================
# VoiceHire Backend - Environment Variables Template
# ====================================================================

# Port Configuration (Render/Railway/Heroku sets PORT dynamically)
PORT=8082
SERVER_PORT=8082

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# --------------------------------------------------------------------
# MongoDB Atlas Connection Configuration
# --------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# IMPORTANT: If your password has special characters (@, #, $, %, etc.), URL-encode them:
# Examples: '@' -> '%40', '#' -> '%23', '%' -> '%25', ':' -> '%3A'
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/voicehire?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/voicehire?retryWrites=true&w=majority&appName=Cluster0
MONGO_DATABASE=voicehire

# --------------------------------------------------------------------
# JWT Authentication Configuration
# --------------------------------------------------------------------
# Secret key (at least 32 characters long)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION=86400000

# --------------------------------------------------------------------
# Email / SMTP Notifications (Optional)
# --------------------------------------------------------------------
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-google-app-password

# --------------------------------------------------------------------
# CORS Allowed Origins
# --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
