# VoiceHire Platform - Environment Variables Template
# Copy this file to .env and fill in appropriate values for your environment.

# Database Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=voicehire
MONGO_URI=mongodb://localhost:27017/voicehire

# Backend Server Configuration
PORT=8082
SERVER_PORT=8082
JWT_SECRET=replace-with-secure-secret-key-at-least-32-chars-long
JWT_EXPIRATION=86400000

# Email / SMTP Notification Settings
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8082/api
