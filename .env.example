# ====================================================================
# VoiceHire Platform - Environment Variables Template
# ====================================================================

# --------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# --------------------------------------------------------------------
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Format: mongodb+srv://<username>:<password>@<cluster-host>/voicehire?retryWrites=true&w=majority
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/voicehire?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/voicehire?retryWrites=true&w=majority&appName=Cluster0
MONGO_DATABASE=voicehire

# --------------------------------------------------------------------
# 2. Backend Server Configuration
# --------------------------------------------------------------------
PORT=8082
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=voicehire_super_secret_jwt_key_2026_udyoga_mitra_platform_secure_token
JWT_EXPIRATION=86400000

# --------------------------------------------------------------------
# 3. Email / SMTP Notification Settings (Optional)
# --------------------------------------------------------------------
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password

# --------------------------------------------------------------------
# 4. Frontend Configuration (Vite)
# --------------------------------------------------------------------
# Set to your hosted backend URL with /api path
# Example: https://voicehire-backend.onrender.com/api
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
VITE_DEFAULT_LANGUAGE=en
VITE_ENABLE_VOICE_SYNTHESIS=true
